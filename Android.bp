//
// Minimal Circle home screen launcher.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "CircleLauncher",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    // Privileged so it can ship in /system/priv-app and bind to Circle
    // SystemServices like circle.privacy without going through the
    // public app sdk surface.
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    optimize: {
        enabled: false,
    },
    // The default home screen. Launcher3QuickStep arrives through
    // handheld_system_ext.mk, which the product inherits and cannot
    // subtract from; with two apps answering HOME and no preference
    // recorded, Android shows a chooser on first boot. Overriding it means
    // the stock launcher is never installed and there is nothing to choose.
    overrides: [
        "Launcher3",
        "Launcher3QuickStep",
    ],

    static_libs: [
        // Privacy AIDLs for the home-screen widget that surfaces the live
        // Circle privacy score.
        "android.circleos-java",
    ],
}
