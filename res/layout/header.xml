<?xml version="1.0" encoding="utf-8"?>
<!--
  Panorama header - guide 2.7. The Circle wordmark, not a generic title,
  and beside it the privacy state from guide 2.5: "a tasteful, persistent
  cue that comms are blind/encrypted - a soul signal WP never had."

  The cue is round because it belongs to the identity layer (2.2), and it
  reports what is actually configured. It is never green by decoration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="@dimen/grid_margin"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/header_start"
        android:textColor="@color/metro_text"
        android:textSize="@dimen/type_display"
        android:fontFamily="@font/selawik_light" />

    <View
        android:id="@+id/privacy_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="6dp"
        android:layout_gravity="bottom"
        android:background="@drawable/presence_dot" />

    <TextView
        android:id="@+id/privacy_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="bottom"
        android:textColor="@color/metro_text_dim"
        android:textSize="@dimen/type_caption"
        android:fontFamily="@font/selawik_light" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!--
      Windows Phone put an arrow at the top right of Start to reach the app
      list, and it is needed here for a reason WP never had: Android's
      system Back gesture owns both screen edges, so a finger swipe that
      starts where a finger naturally starts is taken by the system and the
      pivot never sees it. Measured on a Pixel 7a - an edge swipe stays on
      Start; the same swipe started mid-screen works.

      setSystemGestureExclusionRects (see MetroSurface) reclaims what the
      platform allows, but it is capped, so a gesture alone cannot be the
      only way through. This is the way that always works.
    -->
    <TextView
        android:id="@+id/pivot_arrow"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="@dimen/grid_margin"
        android:gravity="center"
        android:text="\u2192"
        android:textColor="@color/metro_text_dim"
        android:textSize="@dimen/type_header"
        android:fontFamily="@font/selawik_light"
        android:contentDescription="@string/header_apps" />
</LinearLayout>
