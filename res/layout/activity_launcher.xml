<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle Launcher - Circle OS home.
  Top:    Wordmark + live-tile row (clock tile + privacy soul-tile)
  Center: app grid (flat, typography-forward)
  Bottom: search + dock, flat on a true-black canvas
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circle_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="4dp"
            android:text="@string/app_name"
            android:textColor="@color/circle_text"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <!-- Live-tile row: clock (live) + privacy (live) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <!-- Clock tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/tile_bg">

                <TextView
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/circle_text"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/circle_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Privacy soul-tile (live) -->
            <LinearLayout
                android:id="@+id/privacy_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tile_privacy"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="@string/privacy_shield" />

                <TextView
                    android:id="@+id/privacy_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/privacy_status_default"
                    android:textColor="@color/circle_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/privacy_score_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/circle_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <GridView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="4"
            android:horizontalSpacing="0dp"
            android:verticalSpacing="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:stretchMode="columnWidth"
            android:gravity="center"
            android:scrollbarSize="0dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:background="@drawable/search_bar_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/search_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_hint"
                android:textColor="@color/circle_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:background="@drawable/dock_bg">

            <ImageView android:id="@+id/dock_1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/dock_app" />
            <ImageView android:id="@+id/dock_2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/dock_app" />
            <ImageView android:id="@+id/dock_3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/dock_app" />
            <ImageView android:id="@+id/dock_4" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/dock_app" />
            <ImageView android:id="@+id/dock_5" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/dock_app" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
