<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Circle Launcher theme - Circle OS identity.
      True-black canvas, brand-blue (#2196F3) accent, flat surfaces, typography-forward.
      Square-meets-circle: flat tiles with a subtle radius, circular privacy motif.
    -->
    <style name="Theme.CircleLauncher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/circle_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@color/circle_bg</item>
        <item name="android:navigationBarColor">@color/circle_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/circle_bg</item>
        <item name="android:colorAccent">@color/circle_accent</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
