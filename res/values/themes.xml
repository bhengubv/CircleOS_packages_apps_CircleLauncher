<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Circle Launcher theme — HyperOS-inspired.
      Translucent system bars, wallpaper visible, dark Circle brand palette.
    -->
    <style name="Theme.CircleLauncher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:navigationBarColor">#001A1F36</item>
        <item name="android:statusBarColor">#001A1F36</item>
        <item name="android:colorBackground">#1A1F36</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
