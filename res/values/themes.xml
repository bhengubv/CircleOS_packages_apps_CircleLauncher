<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Circle launcher theme. Dark navy background matching Circle brand
      (Circle Deep #1A1F36). Translucent system bars so the privacy
      widget meets the status bar cleanly.
    -->
    <style name="Theme.CircleLauncher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:colorBackground">#1A1F36</item>
    </style>
</resources>
